# Headroom 压缩服务 - 环境变量配置示例
#
# 用法：复制为 .env 并按需修改
#   cp docker/headroom/.env.example docker/headroom/.env
#
# 这些变量会在 docker-compose.yml 中通过 env_file 注入 headroom 服务。

# 监听地址（容器内），默认 0.0.0.0，请勿修改
HEADROOM_HOST=0.0.0.0

# 监听端口，默认 8787
HEADROOM_PORT=8787

# HuggingFace 模型缓存目录（容器内），默认 /models
HF_HOME=/models

# 国内环境建议使用 HuggingFace 镜像
HF_ENDPOINT=https://hf-mirror.com

# worker 数。每个 worker 是独立进程，会独立加载模型。
# 多用户场景建议：CPU 2 核 -> 2；CPU 4 核 -> 2~4；CPU 8 核 -> 4~6。
HEADROOM_WORKERS=2

# 单实例最大并发请求数，防止瞬时并发把 CPU/内存打满。
# 如果还有上游 NEW API 多实例，建议从 30~50 开始。
HEADROOM_MAX_CONCURRENCY=50

# 国内环境避免 tiktoken 在线下载，默认强制使用 Headroom 估算 tokenizer。
# 如服务器能访问 openaipublic.blob.core.windows.net，可设为空字符串，让 Headroom 按请求模型选择 tokenizer。
HEADROOM_FORCE_MODEL=new-api-generic

# 是否压缩用户消息。
# 多用户网关场景建议 false：保护用户最新输入；主要压缩历史上下文、系统消息、工具结果。
HEADROOM_COMPRESS_USER_MESSAGES=false

# 是否压缩系统消息。
# 如果你的系统提示词很长，可以 true；若要求系统提示词绝对原样，改成 false。
HEADROOM_COMPRESS_SYSTEM_MESSAGES=true

# 保护最近 N 条消息不压缩。
# 对聊天/代码场景建议 4；对纯文档压缩可改 0~2。
HEADROOM_PROTECT_RECENT=4

# 小于该 token 数的消息不压缩，避免短消息浪费 CPU。
HEADROOM_MIN_TOKENS_TO_COMPRESS=250

# 日志级别（DEBUG / INFO / WARNING / ERROR）
HEADROOM_LOG_LEVEL=INFO

# Kompress 模型。
# 默认 disabled：稳定优先，避免首次请求下载 ML 模型导致阻塞。
# 如生产环境已能稳定访问 HuggingFace/hf-mirror，可改为空字符串启用默认 Kompress 模型。
HEADROOM_KOMPRESS_MODEL=disabled

# 离线模式（已预下载模型时设为 1，可加速启动并避免联网）
# TRANSFORMERS_OFFLINE=1
